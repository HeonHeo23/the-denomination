{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/app/gameSession.ts",
    "src/app/persistence.ts",
    "src/app/scenarioCatalog.ts",
    "src/scenarios/**/*.ts",
    "src/simulation/**/*.ts",
    "tests/app/**/*.ts"
  ]
}
